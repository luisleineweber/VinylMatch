############################################################
# VinylMatch configuration template
#
# Copy this file to:
#   - .env (project root)          (recommended for local dev)
# or set these as real environment variables.
#
# NEVER commit real credentials. Keep .env untracked.
############################################################

# Required (Spotify Developer Dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Optional (recommended for better Discogs matching)
DISCOGS_TOKEN=your_discogs_token
DISCOGS_USER_AGENT=VinylMatch/1.0 (+your_email_or_contact)
# Optional Jev ranking in the manual Discogs candidate review. Disabled by default.
# JEV_CANDIDATE_MATCHING_ENABLED=true
# TYPESAFE_API_KEY=your_typesafe_api_key
# Optional (required for Discogs OAuth popup login)
# DISCOGS_CONSUMER_KEY=your_discogs_consumer_key
# DISCOGS_CONSUMER_SECRET=your_discogs_consumer_secret
# DISCOGS_REDIRECT_URI=http://127.0.0.1:8888/api/discogs/oauth/callback

# Optional server config
PORT=8888
# PUBLIC_BASE_URL=https://vinylmatch.example.com
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/api/auth/callback
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:8888

# Redis Configuration (required when ENVIRONMENT=production)
# Leave empty or unset only for in-memory local development/test storage
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# Session Configuration
# SESSION_TTL_DAYS=30

# Playlist cache (local to each app instance and its filesystem)
# PLAYLIST_CACHE_TTL_SECONDS=300
# PLAYLIST_CACHE_MAX_MEMORY_ENTRIES=100
# PLAYLIST_CACHE_MAX_DISK_ENTRIES=200
# PLAYLIST_CACHE_MAX_DISK_BYTES=104857600
# PLAYLIST_CACHE_CLEANUP_SECONDS=60

# Request/proxy/provider guardrails
# TRUSTED_PROXY_CIDRS=127.0.0.0/8
# REQUEST_THREADS=32
# PROVIDER_THREADS=8
# PROVIDER_QUEUE_CAPACITY=32
# PROVIDER_TIMEOUT_SECONDS=20
# DISCOGS_PROVIDER_CONCURRENCY=6
# RATE_LIMIT_PER_MINUTE=240
# RATE_LIMIT_BURST=60
# RATE_LIMIT_MAX_BUCKETS=10000
# RATE_LIMIT_IDLE_SECONDS=600

# Logging & Monitoring
# LOG_LEVEL=INFO
# ENVIRONMENT=development
# Errors are logged locally with an X-Correlation-Id; no external tracker is integrated.

# Security: Master Key for Token Encryption (AES-256-GCM)
# IMPORTANT: Generate a secure key with at least 32 characters!
# PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | ForEach-Object { [char]$_ })
# VINYLMATCH_MASTER_KEY=your_32_char_master_key_here

# Admin Users (comma-separated Spotify User IDs)
# These users can access the Curation admin panel
# Find your Spotify User ID at: https://open.spotify.com/user/YOUR_ID
# ADMIN_USER_IDS=spotify_user_id_1,spotify_user_id_2
